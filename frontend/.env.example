# URL de la API que consume la app en el navegador.
# En producción debe apuntar a la API pública, no a localhost.
VITE_API_URL=http://127.0.0.1:8000/api

# Dominio público del sitio. Define el canonical, el og:url y el sitemap.xml.
# Sin esta variable se usa el origen desde el que se sirve la app, que es lo
# correcto en desarrollo pero hace que el SEO apunte a localhost.
# VITE_SITE_URL=https://tu-dominio.com
